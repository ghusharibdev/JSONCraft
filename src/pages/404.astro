---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Page Not Found — JSONCraft" description="The page you are looking for does not exist. Try our JSON tools instead." canonical="https://jsoncraft.dev/404">
  <Header />
  <main>
    <div class="container">
      <div class="four-04">
        <div class="code">404</div>
        <h1>Page Not Found</h1>
        <p>The page you are looking for does not exist or has been moved.</p>
        <div class="actions">
          <a href="/json-beautifier" class="btn btn-primary">JSON Formatter</a>
          <a href="/tools" class="btn btn-secondary">All Tools</a>
          <a href="/" class="btn btn-ghost">Home</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
