---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { guides, SITE } from '../../lib/tool-metadata';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: SITE.url + '/guides' },
    ],
  },
];
---
<BaseLayout title="JSON Guides — Learn to Work with JSON | JSONCraft" description="Practical guides for working with JSON: formatting, error debugging, and best practices for developers." canonical={SITE.url + '/guides'} jsonLd={jsonLd}>
  <Header />
  <main>
    <div class="container">
      <div class="page-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep" aria-hidden="true">/</span>
          <span class="cur" aria-current="page">Guides</span>
        </nav>
        <h1>JSON Guides</h1>
        <p>Practical guides to help you work with JSON more effectively.</p>
      </div>

      <div class="tools-grid">
        {guides.map(g => (
          <a href={'/guides/' + g.slug} class="tool-card">
            <h3>{g.title}</h3>
            <p>{g.description}</p>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
